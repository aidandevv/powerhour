{
  "name": "powerhour",
  "version": "1.0.0",
  "description": "Self-hosted personal finance dashboard with Plaid sync, AI insights, budgeting, and PDF reports.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidandevv/powerhour.git"
  },
  "homepage": "https://github.com/aidandevv/powerhour#readme",
  "bugs": {
    "url": "https://github.com/aidandevv/powerhour/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:docker": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:ensure-views": "node scripts/ensure-views.mjs",
    "prepare": "husky",
    "test": "vitest run --exclude 'e2e/**'",
    "test:watch": "vitest --exclude 'e2e/**'",
    "test:unit": "vitest run --exclude 'tests/integration/**' --exclude 'e2e/**'",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --exclude 'e2e/**' --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:ci": "npm run test:coverage && npm run test:e2e"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "plaid",
    "nextjs",
    "postgresql",
    "ai"
  ],
  "author": "Aidan DeVaney",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/react": "^4.0.147",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "ai": "^7.0.143",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.59.0",
    "next": "^16.2.7",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "plaid": "^48.0.0",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15"
  }
}
