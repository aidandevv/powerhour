# =============================================================================
# powerhour — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# --- Plaid API ---
# Get credentials from https://dashboard.plaid.com/developers/keys
# Your Plaid client ID.
PLAID_CLIENT_ID=
# Your Plaid secret (development or production).
PLAID_SECRET=
# development | sandbox | production
PLAID_ENV=development
# Public URL for webhook delivery, e.g. https://finance.yourdomain.com/api/webhooks/plaid
PLAID_WEBHOOK_URL=

# --- Database ---
# PostgreSQL connection string. For Docker Compose, use the internal service name:
# postgresql://finance_app:YOUR_URL_ENCODED_DB_PASSWORD@db:5432/finance
DATABASE_URL=postgresql://finance_app:replace-with-url-encoded-password@db:5432/finance
POSTGRES_USER=finance_app
# Choose a strong database password. If it contains URL-reserved characters,
# URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=finance
# For the bundled Docker Postgres service, keep this disabled.
# Use "require" for an external managed database that requires TLS.
DATABASE_SSL=disable

# --- Encryption ---
# 32-byte key for AES-256-GCM encryption of Plaid access tokens.
# Generate with: openssl rand -hex 32
# 64 hex characters
ENCRYPTION_KEY=

# --- Session ---
# Secret for iron-session cookie encryption.
# Generate with: openssl rand -hex 64
# Minimum 64 characters
SESSION_SECRET=

# --- Authentication ---
# bcrypt hash of your dashboard password (cost factor >= 12).
# Generate with: node -e "const b=require('bcryptjs');b.hash('YOUR_PASSWORD',12).then(h=>console.log(h))"
# If editing .env manually for Docker Compose, wrap the hash in single quotes so
# Compose does not interpolate the $ characters.
# Used on first login; once you change password in Settings, the new hash is stored in the DB and this is ignored.
# bcrypt hash string starting with $2a$ or $2b$
DASHBOARD_PASSWORD_HASH=

# --- Application ---
# e.g. https://finance.yourdomain.com
NEXT_PUBLIC_APP_URL=
# Docker release image controls.
POWERHOUR_VERSION=latest
POWERHOUR_HOST=127.0.0.1
POWERHOUR_PORT=3000

# --- Demo Mode ---
# Set both to "true" to run the app with seeded fake data (no Plaid required).
# DEMO_MODE is server-only; NEXT_PUBLIC_DEMO_MODE controls client UI (banner, demo login button).
# When enabled, the login password check is bypassed and Plaid/sync endpoints return no-ops.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# --- AI Agent (server-side only) ---
# Provider for chat, budget planner, digest, report narrative, and budget goals.
# google (default) | openai-compatible (Beta: Ollama, llama.cpp server, LM Studio, ...)
AI_PROVIDER=google
# Model id. Defaults to gemini-2.5-flash-lite for google; required for openai-compatible.
AI_MODEL=
# OpenAI-compatible endpoint, required for openai-compatible. Examples:
#   Ollama on this machine:              http://localhost:11434/v1
#   Ollama on the host, app in Docker:   http://host.docker.internal:11434/v1
#   LM Studio:                           http://localhost:1234/v1
#   llama.cpp server:                    http://localhost:8080/v1
AI_BASE_URL=
# Optional bearer token for the OpenAI-compatible endpoint (e.g. llama.cpp --api-key).
AI_API_KEY=
# Set to false if the server rejects response_format=json_schema (budget goals).
AI_STRUCTURED_OUTPUTS=
# Optional per-feature model overrides (fall back to AI_MODEL).
AI_MODEL_CHAT=
AI_MODEL_PLANNER=
AI_MODEL_DIGEST=
AI_MODEL_REPORT=
AI_MODEL_GOALS=
# Optional limits. Hosted defaults: chat 8 steps / 90000 ms, planner 16 steps /
# 120000 ms, digest 30000 ms, report 15000 ms, goals 30000 ms.
# Local Beta defaults: chat 300000 ms, planner 600000 ms, other features 180000 ms.
AI_CHAT_MAX_STEPS=
AI_CHAT_TIMEOUT_MS=
AI_PLANNER_MAX_STEPS=
AI_PLANNER_TIMEOUT_MS=
AI_DIGEST_TIMEOUT_MS=
AI_REPORT_TIMEOUT_MS=
AI_GOALS_TIMEOUT_MS=

# Google Gemini API key. Required only when AI_PROVIDER=google.
# This key MUST NOT have the NEXT_PUBLIC_ prefix — NEXT_PUBLIC_ vars are
# bundled into client-side JavaScript and would be exposed in the browser.
# Get from: https://aistudio.google.com/app/apikey
# Google AI Studio API key (starts with AIza...)
GEMINI_API_KEY=
